#!/usr/bin/env sh
# CPS release history post-commit — refresh runtime deployment_state only.
# Does NOT create commits, amend, push, deploy, or touch canonical DB.
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -n "$ROOT" ] || exit 0

LOG_DIR="$ROOT/logs"
LOCK_DIR="$ROOT/var/release/post_commit.lock"
STATE_PATH="$ROOT/var/release/deployment_state.json"

mkdir -p "$LOG_DIR" 2>/dev/null || true
LOG="$LOG_DIR/release_post_commit.log"

_ts() { date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date -u; }

if git -C "$ROOT" ls-files --error-unmatch var/release/deployment_state.json >/dev/null 2>&1; then
  echo "$(_ts) BLOCKED deployment_state.json is tracked; manifest refresh skipped" >> "$LOG"
  exit 0
fi

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  echo "$(_ts) SKIP post-commit lock busy" >> "$LOG"
  exit 0
fi

trap 'rmdir "$LOCK_DIR" 2>/dev/null' EXIT INT TERM

HEAD_SHA="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null)" || HEAD_SHA="unknown"
echo "$(_ts) post-commit start HEAD=$HEAD_SHA" >> "$LOG"

if ! python "$ROOT/tools/release_state.py" >> "$LOG" 2>&1; then
  echo "$(_ts) WARN release_state.py failed (commit already created)" >> "$LOG"
  exit 0
fi

if [ -f "$STATE_PATH" ]; then
  echo "$(_ts) post-commit ok state=$STATE_PATH" >> "$LOG"
else
  echo "$(_ts) WARN state file missing after release_state.py" >> "$LOG"
fi

exit 0
