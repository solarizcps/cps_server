<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F7FF"
    android:gravity="center">

    <!-- Ana kart -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/card_bg"
        android:margin="32dp"
        android:padding="32dp">

        <!-- Spinner -->
        <ProgressBar
            android:id="@+id/pb_progress"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="#7C3AED"
            android:visibility="visible" />

        <!-- Sonuç ikonu -->
        <TextView
            android:id="@+id/tv_result_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="56sp"
            android:visibility="gone" />

        <!-- Durum mesajı -->
        <TextView
            android:id="@+id/tv_status_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hazırlanıyor..."
            android:textSize="17sp"
            android:textColor="#1E293B"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:lineSpacingMultiplier="1.3" />

        <!-- Alt mesaj (barkod kodu vb.) -->
        <TextView
            android:id="@+id/tv_sub_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#6B7280"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- CPS'ye Dön butonu -->
        <Button
            android:id="@+id/btn_back_cps"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_back_cps"
            android:backgroundTint="#7C3AED"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            android:visibility="gone" />

        <!-- Tekrar Dene butonu -->
        <Button
            android:id="@+id/btn_retry"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_retry"
            android:backgroundTint="#EDE9FE"
            android:textColor="#6D28D9"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
