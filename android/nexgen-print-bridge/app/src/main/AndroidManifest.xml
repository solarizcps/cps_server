<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bluetooth Classic (SPP) izinleri -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Android 12+ -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Ağ (CPS API) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Bluetooth özelliği — zorunlu değil (tablet'te her zaman var) -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.NexGenPrintBridge"
        android:usesCleartextTraffic="true">

        <!-- Ana ekran -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- URL Scheme handler: nexgenprint://print?job_id=...&token=... -->
        <!-- launchMode=singleTask: uygulama kapalıyken yeni task açar,
             açıksa onNewIntent() ile mevcut activity'e iletir -->
        <activity
            android:name=".PrintJobActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.solariz.nexgenprintbridge.print">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="nexgenprint"
                    android:host="print" />
            </intent-filter>
        </activity>

        <!-- Foreground Service: baskı sırasında çalışır, bitince durur -->
        <service
            android:name=".PrintForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
